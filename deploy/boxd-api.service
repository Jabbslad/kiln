[Unit]
Description=boxd unprivileged HTTPS gateway
Wants=boxd-host.service
After=network.target boxd-host.service

[Service]
Type=simple
User=boxd-api
Group=boxd-api
# Loopback is intentional. Override --listen with a private/VPN interface only
# after provisioning a matching certificate and reviewing firewall access.
ExecStart=/usr/local/libexec/boxd-api --listen 127.0.0.1:8443 --host-socket /run/boxd/host.sock --token-file /etc/boxd/admin.token --tls-cert /etc/boxd/tls.crt --tls-key /etc/boxd/tls.key
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure
RestartSec=2
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
