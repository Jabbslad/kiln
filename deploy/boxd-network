#!/bin/sh
# Per-VM network resource helper. `provision` is the only action which changes
# host-global forwarding/firewall policy and must be run explicitly by an operator.
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

die() { echo "boxd-network: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "root required"

case "${1-}" in
provision)
  [ "$#" = 2 ] || die "usage: $0 provision UPLINK"
  uplink=$2
  case "$uplink" in ''|*[!a-zA-Z0-9_.:-]*) die 'invalid uplink' ;; esac
  ip link show dev "$uplink" >/dev/null || die 'uplink does not exist'
  sysctl -w net.ipv4.ip_forward=1
  ip link show boxd0 >/dev/null 2>&1 || { ip link add boxd0 type bridge; ip address add 100.104.0.1/24 dev boxd0; ip link set boxd0 up; }
  nft list table inet boxd_global >/dev/null 2>&1 || nft -f - <<EOF
table inet boxd_global {
 chain input { type filter hook input priority 0; policy accept;
   iifname "boxd0" drop
 }
 chain forward { type filter hook forward priority 0; policy accept;
   iifname "boxd0" oifname "boxd0" drop
   iifname "boxd0" fib daddr type local drop
   iifname "boxd0" ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 } drop
   iifname "boxd0" meta nfproto ipv6 drop
   iifname "boxd0" oifname "$uplink" ct state new,established,related accept
   oifname "boxd0" ct state established,related accept
   oifname "boxd0" drop
   iifname "boxd0" drop
 }
 chain postrouting { type nat hook postrouting priority srcnat; policy accept;
   iifname "boxd0" oifname "$uplink" ip saddr 100.104.0.0/24 masquerade
 }
}
EOF
  ;;
prepare|activate|cleanup)
  [ "$#" = 7 ] || die "usage: $0 prepare|activate|cleanup OWNER NAMESPACE GUEST GATEWAY RESOLVER UID"
  action=$1 owner=$2 ns=$3 guest=$4 gateway=$5 resolver=$6 jail_uid=$7
  echo "$jail_uid" | grep -Eq '^[1-9][0-9]{0,9}$' || die "invalid jail UID"
  echo "$owner" | grep -Eq '^[0-9a-f]{32}$' || die "invalid owner"
  echo "$ns" | grep -Eq '^bd-[a-z0-9]{1,8}-[0-7]$' || die "invalid namespace"
  slot=${ns##*-}
  [ "$guest" = "100.96.$slot.2" ] && [ "$gateway" = "100.96.$slot.1" ] \
    || die "topology does not match namespace slot"
  echo "$resolver" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || die "invalid resolver"
  state=/run/boxd-network
  install -d -m 0700 "$state"
  marker="$state/$ns.owner"
  hostif=$(printf 'v%s' "$ns" | tr -d '-')
  if [ "$action" = cleanup ]; then
    [ -f "$marker" ] || exit 0
    [ "$(cat "$marker")" = "$owner" ] || die "namespace is not owned by this run"
    if [ -e "/run/netns/$ns" ]; then
      [ -e "/sys/class/net/$hostif" ] || die "owned network is incomplete"
      ip netns del "$ns"
    else
      [ ! -e "/sys/class/net/$hostif" ] || die "refusing ambiguous orphan host interface"
    fi
    rm -f "$marker"
    exit 0
  fi
  [ -e /sys/class/net/boxd0 ] || die "operator must provision boxd0 first"
  if [ -f "$marker" ]; then
    [ "$(cat "$marker")" = "$owner" ] || die "namespace already owned"
    if ! [ -e "/run/netns/$ns" ] || ! [ -e "/sys/class/net/$hostif" ] \
      || ! ip -n "$ns" link show tap0 >/dev/null 2>&1 \
      || ! ip netns exec "$ns" nft list table inet boxd_vm >/dev/null 2>&1; then
      die "owned network is incomplete"
    fi
    if [ "$action" = activate ]; then
      ip netns exec "$ns" nft list chain inet boxd_vm forward | grep -q 'comment "boxd_active"' \
        || ip netns exec "$ns" nft add rule inet boxd_vm forward iifname br0 oifname uplink ip saddr "$guest" ct state new,established,related accept comment boxd_active
    fi
    exit 0
  fi
  [ "$action" = prepare ] || die "network is not prepared"
  [ ! -e "/run/netns/$ns" ] || die "refusing unowned namespace"
  [ ! -e "/sys/class/net/$hostif" ] || die "refusing unowned host interface"
  ip netns add "$ns"
  made_ns=1 made_hostif=0
  trap '[ "$made_ns" = 0 ] || ip netns del "$ns" 2>/dev/null || true; [ "$made_hostif" = 0 ] || ip link del "$hostif" 2>/dev/null || true' EXIT
  ip link add "$hostif" type veth peer name uplink netns "$ns"
  made_hostif=1
  ip link set "$hostif" master boxd0
  ip link set "$hostif" up
  ip -n "$ns" link set lo up
  transit=$((slot + 2))
  ip -n "$ns" address add "100.104.0.$transit/24" dev uplink
  ip -n "$ns" link set uplink up
  ip -n "$ns" tuntap add tap0 mode tap user "$jail_uid"
  ip -n "$ns" link set tap0 up
  ip -n "$ns" link add br0 type bridge
  ip -n "$ns" address add "$gateway/24" dev br0
  ip -n "$ns" link set tap0 master br0
  ip -n "$ns" link set br0 up
  ip netns exec "$ns" sysctl -q -w net.ipv4.ip_forward=1 net.ipv6.conf.all.disable_ipv6=1
  ip -n "$ns" route add default via 100.104.0.1
  ip netns exec "$ns" nft -f - <<EOF
table inet boxd_vm {
 chain input { type filter hook input priority 0; policy accept;
   iifname "br0" drop
 }
 chain forward { type filter hook forward priority 0; policy drop;
   iifname "br0" ip saddr != $guest drop
   iifname "br0" ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 } drop
   iifname "br0" meta nfproto ipv6 drop
   iifname "uplink" oifname "br0" ip daddr $guest ct state established,related accept
 }
 chain postrouting { type nat hook postrouting priority srcnat; policy accept;
   iifname "br0" oifname "uplink" ip saddr $guest masquerade
 }
}
EOF
  printf '%s\n' "$owner" >"$marker"
  trap - EXIT
  ;;
run)
  [ "$#" -ge 5 ] || die "usage: $0 run OWNER NAMESPACE PROGRAM [ARGS...]"
  owner=$2 ns=$3 marker="/run/boxd-network/$3.owner"
  [ -f "$marker" ] && [ "$(cat "$marker")" = "$owner" ] || die "namespace ownership mismatch"
  shift 3
  # ip netns exec remounts /sys and hides the cgroup2 hierarchy from jailer.
  # Enter only the network namespace; jailer establishes its own mount jail.
  exec nsenter --net="/run/netns/$ns" -- "$@"
  ;;
*) die "expected provision, prepare, activate, cleanup, or run" ;;
esac
