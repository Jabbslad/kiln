[Unit]
Description=boxd privileged microVM host service
After=local-fs.target

[Service]
Type=simple
User=root
Group=boxd-api
Environment=PATH=/opt/boxd/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/libexec/boxd-host --config /etc/boxd/host.json
RuntimeDirectory=boxd
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=boxd
StateDirectoryMode=0700
UMask=0077
# VMMs have independent durable identities; restarting the manager must not
# terminate them. Explicit box stop/delete performs controlled VM shutdown.
KillMode=process
Restart=on-failure
RestartSec=2
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
