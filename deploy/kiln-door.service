[Unit]
Description=Kiln public door
After=network-online.target kiln-api.service
Wants=kiln-api.service
ConditionPathExists=/etc/kiln/identity.json
ConditionPathExists=/etc/kiln/door.crt
ConditionPathExists=/etc/kiln/door.key
ConditionPathExists=/etc/kiln/door.env

[Service]
Type=simple
User=kiln-api
Group=kiln-api
EnvironmentFile=/etc/kiln/door.env
ExecStart=/usr/local/libexec/kiln-api door --listen ${KILN_DOOR_LISTEN} --upstream https://127.0.0.1:8443 --tls-cert /etc/kiln/door.crt --tls-key /etc/kiln/door.key --upstream-ca /etc/kiln/ca.crt --enrollment-file /etc/kiln/identity.json --jwks-cache /var/lib/kiln-api/jwks.json
UMask=0077
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6
Restart=on-failure
RestartSec=2
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
