[Unit]
Description=Public fallback socket for the Kiln door

[Socket]
# The bridge socket allows only 172.18.0.3/32. A second listener on that unit would use the same filter.
ListenStream=78.46.98.73:8443
FreeBind=yes
NoDelay=true
Service=kiln-door-proxy.service
IPAddressDeny=any
IPAddressAllow=0.0.0.0/0

[Install]
WantedBy=sockets.target
