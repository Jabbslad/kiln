[Unit]
Description=kiln unprivileged HTTPS gateway
Wants=kiln-host.service
After=network.target kiln-host.service

[Service]
Type=simple
User=kiln-api
Group=kiln-api
# Loopback is intentional. Override --listen with a private/VPN interface only
# after provisioning a matching certificate and reviewing firewall access.
ExecStart=/usr/local/libexec/kiln-api --listen 127.0.0.1:8443 --host-socket /run/kiln/host.sock --token-file /etc/kiln/admin.token --tls-cert /etc/kiln/tls.crt --tls-key /etc/kiln/tls.key
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure
RestartSec=2
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
